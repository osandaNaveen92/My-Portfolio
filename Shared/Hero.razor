<header class="hero" id="top">

    <div class="hero-grid">
        <div class="hero-copy">
            <p class="eyebrow">// INTRODUCTION</p>
            <h1 class="hero-name">Hello, I'm @PortfolioData.FullName</h1>
            <p class="hero-role">@PortfolioData.RoleTitle</p>
            <p class="hero-tagline">@PortfolioData.Tagline</p>

            <div class="hero-actions">
                <a class="btn btn-primary" href="@PortfolioData.ResumeUrl" target="_blank" rel="noopener">Download Resume</a>
                <a class="btn btn-ghost" href="#projects">View Projects</a>
            </div>
        </div>

        <div class="hero-visual">
            <div class="hero-photo-frame">
                <img src="@PortfolioData.ProfileImageUrl" alt="@PortfolioData.FullName" class="hero-photo" />
            </div>
            <svg class="hero-waveform" viewBox="0 0 320 90" preserveAspectRatio="none" aria-hidden="true">
                <polyline class="wave-path"
                    points="0,45 24,45 34,15 44,75 54,45 90,45 100,10 110,80 120,45 160,45 172,25 184,65 196,45 320,45" />
            </svg>
        </div>
    </div>
</header>
