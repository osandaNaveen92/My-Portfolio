<section class="section" id="projects">
    <p class="eyebrow">// PROJECTS</p>

    <div class="project-list">
        @foreach (var project in PortfolioData.Projects)
        {
            <article class="project-card">
                <div class="project-media">
                    @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                    {
                        <img class="project-image" src="@project.ImageUrl" alt="@project.ImageAlt" />
                    }
                    else
                    {
                        <div class="project-image project-image-placeholder" aria-label="Project image placeholder">
                            Add project image
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(project.LinkUrl))
                    {
                        <a class="project-link" href="@project.LinkUrl" target="_blank" rel="noopener">View project →</a>
                    }
                </div>

                <div class="project-content">
                    <div class="project-head">
                        <span class="project-tag">@project.Tag</span>
                        <span class="project-date">@project.DateRange</span>
                    </div>
                    <h3 class="project-title">@project.Title</h3>
                    <p class="project-stack">@project.StackLine</p>
                    <ul class="project-highlights">
                        @foreach (var highlight in project.Highlights)
                        {
                            <li>@highlight</li>
                        }
                    </ul>
                </div>
            </article>
        }
    </div>
</section>
<SignalDivider />
