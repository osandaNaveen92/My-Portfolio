    <h2 class="footer-heading">Let's build something.</h2>
    <p class="footer-sub">Open to Data Science/Analytics and Software Engineering internship opportunities — reach out any time.</p>

    <div class="footer-links">
        <a class="btn btn-primary" href="mailto:@PortfolioData.Email">@PortfolioData.Email</a>
        <a class="btn btn-ghost" href="tel:@PortfolioData.Phone">@PortfolioData.Phone</a>
    </div>

    <div class="footer-social">
        <a href="@PortfolioData.GitHubUrl" target="_blank" rel="noopener">GitHub</a>
        <a href="@PortfolioData.LinkedInUrl" target="_blank" rel="noopener">LinkedIn</a>
        <a href="@PortfolioData.ResumeUrl" target="_blank" rel="noopener">Resume</a>
    </div>

    <p class="footer-copyright">© @DateTime.Now.Year @PortfolioData.FullName.</p>
</footer>
